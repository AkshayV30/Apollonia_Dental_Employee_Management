{
  "name": "@apollonia/backend",
  "version": "2.0.0",
  "description": "Node.js REST API with Express, PostgreSQL, Prisma and TypeScript",
  "private": "true",
  "engines": {
    "node": ">=24.11.0"
  },
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "prisma:emit": "prisma contract emit",
    "prisma:infer": "prisma contract infer --output ./src/prisma/contract.prisma",
    "prisma:verify": "prisma db verify",
    "db:plan": "prisma migration plan",
    "db:migrate": "prisma db migrate",
    "db:init": "prisma db init",
    "seed": "tsx src/seed/seed.ts",
    "contract:emit": "prisma contract emit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "^8.0.0-rc.12",
    "bcryptjs": "^3.0.3",
    "chalk": "^5.6.2",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/http-status-codes": "^1.2.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.17.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.4",
    "prisma": "^8.0.0-rc.17",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2"
  }
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  users       User[]
  employees   Employee[]
  departments Department[]
  patients    Patient[]

  @@map("tenants")
}

enum UserRole {
  ADMIN
  STAFF
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(uuid())
  tenantId     String     @map("tenant_id")
  name         String
  email        String
  passwordHash String     @map("password_hash")
  role         UserRole   @default(STAFF)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("users")
}

model Department {
  id             String               @id @default(uuid())
  tenantId       String               @map("tenant_id")
  departmentCode String               @map("department_code")
  name           String
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees      EmployeeDepartment[]

  @@unique([tenantId, departmentCode])
  @@unique([tenantId, name])
  @@map("departments")
}

model Employee {
  id                String               @id @default(uuid())
  tenantId          String               @map("tenant_id")
  employeeCode      String               @map("employee_code")
  firstName         String               @map("first_name")
  lastName          String               @map("last_name")
  dateOfJoining     DateTime?            @map("date_of_joining")
  specialization    String?
  yearsOfExperience Int                  @default(0) @map("years_of_experience")
  backgroundInfo    String?              @map("background_info")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments       EmployeeDepartment[]
  patients          EmployeePatient[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId, firstName, lastName])
  @@map("employees")
}

model EmployeeDepartment {
  employeeId   String   @map("employee_id")
  departmentId String   @map("department_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([employeeId, departmentId])
  @@map("employee_departments")
}

model Patient {
  id             String            @id @default(uuid())
  tenantId       String            @map("tenant_id")
  patientCode    String            @map("patient_code")
  patientName    String            @map("patient_name")
  patientImage   String?           @map("patient_image")
  treatmentNotes String?           @map("treatment_notes")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees      EmployeePatient[]
  revenues       Revenue[]

  @@unique([tenantId, patientCode])
  @@map("patients")
}

model EmployeePatient {
  employeeId String   @map("employee_id")
  patientId  String   @map("patient_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@id([employeeId, patientId])
  @@map("employee_patients")
}

model Revenue {
  id          String   @id @default(uuid())
  patientId   String   @map("patient_id")
  amount      Decimal
  description String?
  revenueDate DateTime @default(now()) @map("revenue_date")
  createdAt   DateTime @default(now()) @map("created_at")

  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("revenues")
}

model Training {
  id          String   @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("trainings")
}

model Specialization {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("specializations")
}
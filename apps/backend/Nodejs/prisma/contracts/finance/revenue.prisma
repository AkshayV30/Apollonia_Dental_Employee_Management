// use prisma-8

// ============================================================
// REVENUE
// ============================================================
//
// Tenant ownership:
// Revenue -> Patient -> Tenant
//
// tenantId is intentionally not duplicated here.
// ============================================================

model Revenue {
  // Prisma 8 natively uses the Uuid type directly
  id Uuid @id @default(uuid())

  patientId Uuid @map("patient_id")

  // standard PSL decimal type mapping
  amount Decimal

  description String?

  revenueDate DateTime @default(now()) @map("revenue_date")

  createdAt DateTime @default(now()) @map("created_at")

  // ----------------------------------------------------------
  // Relations
  // ----------------------------------------------------------

  patient Patient @relation(
    fields: [patientId],
    references: [id],
    onDelete: Cascade
  )

  @@index([patientId, revenueDate])

  @@map("revenues")
}

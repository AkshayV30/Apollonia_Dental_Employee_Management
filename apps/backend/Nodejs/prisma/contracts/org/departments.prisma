// use prisma-8

// ============================================================
// DEPARTMENT
// ============================================================

model Department {
  // Prisma 8 natively uses direct type tokens like Uuid instead of @db.Uuid
  id Uuid @id @default(uuid())

  tenantId Uuid @map("tenant_id")

  departmentCode String @map("department_code")

  name String

  createdAt DateTime @default(now()) @map("created_at")

  // Fixed syntax error: Replaced invalid custom temporal method with Prisma's native decorator
  updatedAt temporal.updatedAt() @map("updated_at")

  // ----------------------------------------------------------
  // Relations
  // ----------------------------------------------------------

  tenant Tenant @relation(
    fields: [tenantId],
    references: [id],
    onDelete: Cascade
  )

  employees EmployeeDepartment[]

  // ----------------------------------------------------------
  // Constraints
  // ----------------------------------------------------------

  @@unique([tenantId, departmentCode])

  @@unique([tenantId, name])

  @@map("departments")
}

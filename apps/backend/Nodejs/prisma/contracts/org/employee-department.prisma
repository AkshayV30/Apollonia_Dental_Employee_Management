// ============================================================
// EMPLOYEE <-> DEPARTMENT
// ============================================================

model EmployeeDepartment {
  employeeId Uuid @map("employee_id")

  departmentId Uuid @map("department_id")

  assignedAt DateTime @default(now()) @map("assigned_at")

  // ----------------------------------------------------------
  // Relations
  // ----------------------------------------------------------

  employee Employee @relation(
    fields: [employeeId],
    references: [id],
    onDelete: Cascade
  )

  department Department @relation(
    fields: [departmentId],
    references: [id],
    onDelete: Cascade
  )

  @@id([employeeId, departmentId])

  @@map("employee_departments")
}

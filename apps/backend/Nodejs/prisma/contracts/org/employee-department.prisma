// use prisma-8

// ============================================================
// EMPLOYEE <-> DEPARTMENT
// ============================================================

model EmployeeDepartment {
  // Prisma 8 uses the pure Uuid type token directly without @db decorators
  employeeId Uuid @map("employee_id")

  departmentId Uuid @map("department_id")

  assignedAt DateTime @default(now()) @map("assigned_at")

  // ----------------------------------------------------------
  // Relations
  // ----------------------------------------------------------

  employee Employee @relation(
    fields: [employeeId],
    references: [id],
    onDelete: Cascade
  )

  department Department @relation(
    fields: [departmentId],
    references: [id],
    onDelete: Cascade
  )

  // Defines a composite primary key using the modern contract array format
  @@id([employeeId, departmentId])

  @@map("employee_departments")
}

// use prisma-8

// ============================================================
// TENANT
// ============================================================

model Tenant {
  // PostgreSQL native UUID primary key.
  id Uuid @id @default(uuid())

  // Human-readable tenant name.
  name String

  // Globally unique tenant identifier used by routing/auth.
  slug String @unique

  // Set once when the row is created.
  createdAt DateTime @default(now()) @map("created_at")

  // Automatically updated whenever this record changes.
  updatedAt DateTime @updatedAt @map("updated_at")

  // ----------------------------------------------------------
  // Relations
  // ----------------------------------------------------------

  users       User[]
  employees   Employee[]
  departments Department[]
  patients    Patient[]

  // Physical PostgreSQL table name.
  @@map("tenants")
}
